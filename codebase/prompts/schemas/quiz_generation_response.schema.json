{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "VLearnQuizGenerationResponse",
  "type": "object",
  "required": [
    "status",
    "user_message",
    "safe_question_count",
    "missing_coverage",
    "warnings",
    "quiz_metadata",
    "public_quiz",
    "private_answer_key"
  ],
  "properties": {
    "status": {
      "enum": [
        "ready",
        "need_clarification",
        "insufficient_grounding",
        "source_conflict"
      ]
    },
    "user_message": {
      "type": "string"
    },
    "safe_question_count": {
      "type": "integer",
      "minimum": 0,
      "maximum": 20
    },
    "missing_coverage": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "quiz_metadata": {
      "type": "object",
      "required": [
        "title",
        "material_ids",
        "scope_description",
        "question_count",
        "difficulty_distribution"
      ],
      "properties": {
        "title": {
          "type": "string"
        },
        "material_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "scope_description": {
          "type": "string"
        },
        "question_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 20
        },
        "difficulty_distribution": {
          "type": "object",
          "required": [
            "recognition",
            "understanding",
            "application",
            "analysis"
          ],
          "properties": {
            "recognition": {
              "type": "integer",
              "minimum": 0
            },
            "understanding": {
              "type": "integer",
              "minimum": 0
            },
            "application": {
              "type": "integer",
              "minimum": 0
            },
            "analysis": {
              "type": "integer",
              "minimum": 0
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "public_quiz": {
      "type": "object",
      "required": [
        "questions"
      ],
      "properties": {
        "questions": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "question_id",
              "learning_objective",
              "difficulty",
              "question",
              "options"
            ],
            "properties": {
              "question_id": {
                "type": "string"
              },
              "learning_objective": {
                "type": "string"
              },
              "difficulty": {
                "enum": [
                  "recognition",
                  "understanding",
                  "application",
                  "analysis"
                ]
              },
              "question": {
                "type": "string",
                "minLength": 10
              },
              "options": {
                "type": "array",
                "minItems": 4,
                "maxItems": 4,
                "items": {
                  "type": "object",
                  "required": [
                    "option_id",
                    "text"
                  ],
                  "properties": {
                    "option_id": {
                      "enum": [
                        "A",
                        "B",
                        "C",
                        "D"
                      ]
                    },
                    "text": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "additionalProperties": false
                }
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "private_answer_key": {
      "type": "object",
      "required": [
        "items"
      ],
      "properties": {
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "question_id",
              "correct_option_id",
              "explanation",
              "option_explanations",
              "citations",
              "grounding_confidence"
            ],
            "properties": {
              "question_id": {
                "type": "string"
              },
              "correct_option_id": {
                "enum": [
                  "A",
                  "B",
                  "C",
                  "D"
                ]
              },
              "explanation": {
                "type": "string"
              },
              "option_explanations": {
                "type": "object",
                "required": [
                  "A",
                  "B",
                  "C",
                  "D"
                ],
                "properties": {
                  "A": {
                    "type": "string"
                  },
                  "B": {
                    "type": "string"
                  },
                  "C": {
                    "type": "string"
                  },
                  "D": {
                    "type": "string"
                  }
                },
                "additionalProperties": false
              },
              "citations": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "required": [
                    "source_id",
                    "material_id",
                    "chunk_id",
                    "display",
                    "supporting_quote"
                  ],
                  "properties": {
                    "source_id": {
                      "type": "string"
                    },
                    "material_id": {
                      "type": "string"
                    },
                    "page": {
                      "type": [
                        "integer",
                        "null"
                      ],
                      "minimum": 1
                    },
                    "chunk_id": {
                      "type": "string"
                    },
                    "display": {
                      "type": "string"
                    },
                    "supporting_quote": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "additionalProperties": false
                }
              },
              "grounding_confidence": {
                "const": "high"
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}