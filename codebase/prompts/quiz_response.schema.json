{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "vlearn-quiz-response.schema.json",
  "title": "VLearn Quiz Generation Response",
  "description": "Contract used by codebase/server.py. The exact question count is validated at runtime.",
  "type": "object",
  "oneOf": [
    {
      "required": [
        "questions"
      ],
      "properties": {
        "questions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "question",
              "options",
              "correct_option",
              "explanation",
              "citation"
            ],
            "properties": {
              "question": {
                "type": "string",
                "minLength": 1
              },
              "options": {
                "type": "array",
                "minItems": 4,
                "maxItems": 4,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "correct_option": {
                "type": "string",
                "enum": [
                  "A",
                  "B",
                  "C",
                  "D"
                ]
              },
              "explanation": {
                "type": "string",
                "minLength": 1
              },
              "citation": {
                "type": "string",
                "minLength": 1
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    {
      "required": [
        "questions",
        "refusal"
      ],
      "properties": {
        "questions": {
          "type": "array",
          "maxItems": 0
        },
        "refusal": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    }
  ]
}
